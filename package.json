{
  "name": "tap2pay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SCPP: an open protocol for authorising a stablecoin payment with a tap",
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
